CAPI=2:

name: "isa:lab3:prim-sg13g2"
description: "IHP SG13G2 cells for the X-HEEP primitives, the pads and the SRAM wrappers"

filesets:
  rtl:
    files:
    - rtl/sg13g2_clk_cells.sv
    - rtl/sg13g2_pad_cells.sv
    - rtl/sg13g2_sram_wrapper.sv
    - rtl/sg13g2_sram_wrapper_2p.sv
    file_type: systemVerilogSource

  # Simulation models of the PDK cells: pdk/ is a link to $IHP_PDK_ROOT (make pdk-link).
  models:
    files:
    - pdk/libs.ref/sg13g2_stdcell/verilog/sg13g2_udp.v
    - pdk/libs.ref/sg13g2_stdcell/verilog/sg13g2_stdcell.v
    - pdk/libs.ref/sg13g2_io/verilog/sg13g2_io.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_core_behavioral_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_2P_core_behavioral_bm_bist_ideal.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_2P_core_behavioral_ideal.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_64x64_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_256x8_c3_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_256x16_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_256x32_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_256x48_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_256x64_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_512x8_c3_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_512x16_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_512x32_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_512x64_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_1024x8_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_1024x16_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_1024x32_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_1024x64_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_2048x32_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_2048x64_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_4096x8_c3_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_1P_4096x16_c3_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_2P_1024x32_c2_bm_bist.v
    - pdk/libs.ref/sg13g2_sram/verilog/RM_IHPSG13_2P_64x32_c2.v
    file_type: verilogSource

targets:
  default:
    filesets:
    - "!target_sim_postsynthesis ? (!target_sim_postlayout ? (rtl))"
    - "!target_asic_synthesis ? (models)"
